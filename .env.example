# 1n9 Match — check documents against your criteria. Copy to .env and fill in. Never commit .env.
#
# Only CENTRAL_URL, LICENSE_KEY and NODE_PASSWORD are needed. AI connections and models are
# easier to set up on the Settings page; the model values below are only used as defaults
# the first time the app starts. Everything is then stored encrypted in data/node.db.

# Central address and the license key you received
# Must be https:// — plain http is only allowed for localhost, a docker service name or a private LAN address
CENTRAL_URL=https://central.1n9ai.com
LICENSE_KEY=
# (optional) trust only the CA in this file for central (certificate pinning)
# CENTRAL_CA_FILE=/app/data/central-ca.pem

# Web login (Basic Auth). The documents you check can be confidential — always set a password.
NODE_USER=admin
NODE_PASSWORD=

# Who can reach the app: 127.0.0.1 = this machine only · 0.0.0.0 = whole network
NODE_BIND=127.0.0.1
MATCH_PORT=8081

# Encryption key for stored API keys. Empty = generated into data/secret.key (back it up with node.db)
# NODE_SECRET_KEY=

# Largest document file accepted (MB)
# MAX_DOC_MB=20

# ── Optional first-start defaults (you can leave all of these empty) ──
# LLM — turns pasted text into a requirement list. google | openai_compatible | ollama
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Embedding — reads documents so they can be searched. A checklist keeps the model it was created with.
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_DIM=
EMBED_API_KEY=
EMBED_BASE_URL=

# Rerank (optional, recommended) — an endpoint with /rerank
RERANK_MODEL=
RERANK_API_KEY=
RERANK_BASE_URL=

# Vector database (where the documents are stored for search)
#   local    = Qdrant on this machine (default; docker compose includes one). Central reaches it through a tunnel this app opens itself.
#   qdrant   = a Qdrant that central can reach directly, e.g. Qdrant Cloud (set QDRANT_URL + QDRANT_API_KEY)
#   pgvector / pinecone: set in the web UI (Settings)
VECTOR_TYPE=local
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
